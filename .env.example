BOT_TOKEN=123456:REPLACE_ME

BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
# Webhook rejimida MAJBURIY (bo'sh bo'lsa app ishga tushmaydi). Uzun tasodifiy qiymat qo'ying.
WEBHOOK_SECRET=
WEBAPP_URL=https://your-domain.example/webapp
BOT_USERNAME=

POSTGRES_USER=fittrack
# ⚠️ PRODUCTION'da albatta o'zgartiring — bu default zaif parol faqat dev uchun.
POSTGRES_PASSWORD=fittrack
POSTGRES_DB=fittrack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DB connection pool (ixtiyoriy)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Xavfsizlik / abuse (ixtiyoriy)
INIT_DATA_MAX_AGE_SECONDS=3600
ONBOARDING_MIN_INTERVAL_SECONDS=20

API_HOST=0.0.0.0
API_PORT=8000
HOST_PORT=8100

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

LOG_LEVEL=INFO
TZ=Asia/Tashkent
ENV=development
ADMINS=
