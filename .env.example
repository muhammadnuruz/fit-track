# ---------------------------------------------------------------------------
# FitTrack Bot — muhit o'zgaruvchilari namunasi.
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
# ---------------------------------------------------------------------------

# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456:REPLACE_ME

# Ishlash rejimi: polling (soddaroq, dev) | webhook (production)
BOT_MODE=polling
# webhook rejimi uchun (production):
# WEBHOOK_URL=https://example.com
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=change_me

# --- Ma'lumotlar bazasi (docker-compose bilan mos) ---
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack
POSTGRES_DB=fittrack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# To'liq DSN (agar berilsa, yuqoridagilarni bekor qiladi):
# DATABASE_URL=postgresql+asyncpg://fittrack:fittrack@localhost:5432/fittrack

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Embedding modeli (Bosqich 1) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Umumiy ---
LOG_LEVEL=INFO
TZ=Asia/Tashkent
ENV=development
