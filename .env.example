BOT_TOKEN=123456:REPLACE_ME

BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
# Webhook rejimida MAJBURIY (bo'sh bo'lsa app ishga tushmaydi). Uzun tasodifiy qiymat qo'ying.
WEBHOOK_SECRET=

POSTGRES_USER=fittrack
# ⚠️ PRODUCTION'da albatta o'zgartiring — bu default zaif parol faqat dev uchun.
POSTGRES_PASSWORD=fittrack
POSTGRES_DB=fittrack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DB connection pool (ixtiyoriy)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Redis: bo'sh bo'lsa FSM/throttle/til-cache in-memory (1 instans). Ko'p replica uchun to'ldiring.
# docker-compose ichida default: redis://redis:6379/0
REDIS_URL=

API_HOST=0.0.0.0
API_PORT=8000
HOST_PORT=8100

LOG_LEVEL=INFO
TZ=Asia/Tashkent
ENV=development
ADMINS=
